# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to Git!

# ========================================
# DEVELOPMENT MODE (Choose one)
# ========================================

# Option 1: LOCAL DEVELOPMENT (Supabase Local - FAST! 1-10ms)
# Use these values when running Supabase locally
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<from-supabase-start-output>
# SUPABASE_SERVICE_ROLE_KEY=<from-supabase-start-output>

# Option 2: CLOUD DEVELOPMENT (Supabase Cloud - 100-500ms)
# Public keys (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (DANGEROUS - only use in API routes, never in client components!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App secrets
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-character-hex-key-here

# Optional bootstrap admin list. First registered user becomes Admin if no Admin exists.
# Add comma-separated emails here to force those accounts to Admin on registration/profile sync.
ADMIN_EMAILS=

# Supabase Storage bucket used for server-side tool files.
SUPABASE_TOOL_FILES_BUCKET=tool-files

# Optional: required for production-grade rate limiting.
# Without these, rate limiting is intentionally disabled for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App Configuration
NEXT_PUBLIC_APP_NAME=Tool Website
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cobalt API Configuration (Media Downloader)
# Use a valid instance from: https://instances.cobalt.tools/
# Default: https://api.cobalt.tools (May be rate limited)
COBALT_API_URL=https://api.cobalt.tools

# Puppeteer / Scribd downloader
# On Vercel/serverless, Chromium is provided by @sparticuz/chromium automatically.
# For self-hosted servers with Chrome already installed, set one of these paths if needed.
PUPPETEER_EXECUTABLE_PATH=
CHROME_EXECUTABLE_PATH=
GOOGLE_CHROME_BIN=

# Force serverless Chromium outside Vercel/AWS/Netlify if your deployment has no system Chrome.
USE_SERVERLESS_CHROMIUM=
